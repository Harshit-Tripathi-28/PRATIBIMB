# PRATIBIMB AI Operating Layer Configuration
# Optional LLM API keys for real neural intelligence reasoning.
# If none are provided, Pratibimb operates in honest deterministic standby mode.

# Google Gemini (Recommended)
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Ollama (Self-hosted)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3
